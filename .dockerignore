# Keep the Docker build context small. `demos/aws/Dockerfile` does `COPY . /src/suite3d`
# because `pip install -e` needs pyproject.toml at the repo root.
.git
.github
**/__pycache__
**/*.pyc
**/.ipynb_checkpoints
.venv
venv
*.egg-info
build/
dist/

# Development material that has no business in a demo image.
dev/
benchmarking/
debugging/

# ...except the paper speed benchmark, which both Dockerfiles COPY into /work.
# Must come after `benchmarking/`: the last matching pattern wins.
!benchmarking/paper/
benchmarking/paper/**/__pycache__
benchmarking/paper/**/*.pyc
